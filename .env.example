# Copia este archivo como .env.local, en esta misma carpeta, y pon tu clave.
# .env.local nunca se sube a GitHub.

# Clave de OpenRouter (https://openrouter.ai/keys). La usan el asistente de la web y la
# evaluación por voz de la gestión. Sin ella, todo funciona igual: el asistente contesta
# con la ficha de la autoescuela y los profesores rellenan la evaluación a mano.
OPENROUTER_API_KEY=

# Opcional: modelo del asistente de la web (por defecto, anthropic/claude-haiku-5.5).
# El de la evaluación por voz se elige en la gestión: Secretaría → Ajustes.
OPENROUTER_MODEL=

# Opcional: otra ruta para la base de datos (por defecto, datos/faro.db). La usan las pruebas.
# FARO_DB=
